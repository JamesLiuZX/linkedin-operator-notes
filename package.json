{
  "name": "linkedin-operator-notes",
  "private": true,
  "type": "module",
  "scripts": {
    "content:check": "node scripts/content-check.mjs",
    "content:check:json": "node scripts/content-check.mjs --json",
    "content:strict": "node scripts/content-check.mjs --strict",
    "linkedin": "node scripts/linkedin.mjs",
    "linkedin:list": "node scripts/linkedin.mjs --list",
    "unsplash": "node scripts/fetch-unsplash.mjs",
    "site": "node scripts/gate-scores.mjs && npm --prefix site run dev",
    "site:install": "npm --prefix site install",
    "site:build": "node scripts/gate-scores.mjs && node scripts/build-apps.mjs && npm --prefix site run build",
    "publish": "node scripts/publish/index.mjs",
    "publish:dry": "node scripts/publish/index.mjs --dry-run --scheduled",
    "publish:list": "node scripts/publish/index.mjs --list",
    "publish:status": "node scripts/publish/index.mjs --status",
    "desk": "npm --prefix tools/content-desk run dev",
    "desk:install": "npm --prefix tools/content-desk install",
    "apps": "node scripts/build-apps.mjs",
    "ledger": "node scripts/ledger/index.mjs",
    "ledger:test": "node scripts/ledger/selftest.mjs",
    "risk": "node tools/resolution-risk/scan.mjs",
    "risk:test": "node tools/resolution-risk/test.mjs",
    "site:data": "node scripts/gate-scores.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
