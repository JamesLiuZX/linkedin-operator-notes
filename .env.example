# Canonical site URL (deploy site/ first — see PUBLISHING.md)
SITE_URL=https://your-site.vercel.app

# ── Restyle Lab demo (scripts/restyle-generate.mjs) ────
# fal.ai key for real video generation (Seedance, Kling, Veo, Sora, etc).
# Leave empty to use the CLI in dry-run mode (prints the compiled prompt only).
# https://fal.ai/dashboard/keys
FAL_KEY=

# ── Medium ──────────────────────────────────────────────
# Medium stopped issuing new tokens (leave empty for import-URL mode).
# https://help.medium.com/hc/en-us/articles/213480228-API-Importing
MEDIUM_INTEGRATION_TOKEN=
MEDIUM_USER_ID=

# ── Twitter / X ─────────────────────────────────────────
# developer.twitter.com → Project → App → Keys & tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── Substack (post-by-email) ────────────────────────────
# Substack Settings → Publishing → Post by email
SUBSTACK_POST_EMAIL=yourpub+post@substack.com
SUBSTACK_PUBLICATION_URL=https://yourpub.substack.com

# Email delivery for Substack (pick one):
# Option A: Resend (recommended — resend.com)
RESEND_API_KEY=
RESEND_FROM=publish@yourdomain.com

# Option B: SMTP (requires: npm install nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
