{
  "doc": {
    "title": "Larkspur: Share by link to get a second person in",
    "short": "Share by link PRD",
    "eyebrow": "Draft for decision",
    "author": "Product, Larkspur",
    "date": "2026-11-19",
    "summary": "This replaces Team suggestions with Share by link: one page, shared by a link the admin sends, view only and free. Six points in three groups, with a rollout and what to measure. It is for a decision this week.",
    "fictional": true
  },
  "sources": [
    {
      "id": "T",
      "label": "Journey teardown",
      "detail": "4 products, 3 stages, 24 screens"
    },
    {
      "id": "S",
      "label": "Interview synthesis",
      "detail": "8 people who started a trial alone"
    },
    {
      "id": "R",
      "label": "Pre-mortem on Team suggestions",
      "detail": "10 risks, 5 with tripwires"
    }
  ],
  "sourceNote": "Every screen is a schematic drawn from the teardown, on 19 November 2026. Larkspur, Corbel and Halyard are fictional. Nothing here was timed or measured.",
  "sections": [
    {
      "n": 1,
      "id": "link",
      "title": "The link",
      "summary": "A free, view-only link, and a preview of what it shows.",
      "lead": "The admin needs a way to let someone look without paying, and to see what that person will see first.",
      "points": [
        {
          "id": "1.1",
          "title": "Admins have no free way to show a plan",
          "problem": "Every second person is a paid seat and there is no share link. 5 of 8 interviewees wanted someone to look, not edit, and found only Add member.",
          "change": "Put a Share button top right on every page. It makes a link that anyone can open to view the page, view only, free to the guest, and the admin sends it to whoever they choose.",
          "why": "Three of the five fell back to a PDF, screenshots or nothing, which is the outcome this point removes.",
          "constraint": {
            "label": "Needs security sign-off",
            "text": "The security team has questions about public links and has not signed off. 3 of 8 interviewees doubted a link would pass their company's review. The design gives the admin a switch to turn sharing off, and the first release does not ship until security signs off."
          },
          "evidence": [
            {
